#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

MODE="${1:-all}"
SBT_CMD=(sbt --batch -Dsbt.supershell=false)

case "$MODE" in
  prototype)
    "${SBT_CMD[@]}" "runMain contract.ValidateJourney prototype"
    ;;
  service)
    "${SBT_CMD[@]}" "runMain contract.ValidateJourney service"
    ;;
  all)
    "${SBT_CMD[@]}" "runMain contract.ValidateJourney all"
    ;;
  *)
    echo "Usage: ./scripts/validate-journey [prototype|service|all]"
    exit 1
    ;;
esac
